# Default environment variables for generated Celo projects
# Public Celo RPC (mainnet)
CELO_RPC_URL=https://forno.celo.org


# RainbowKit Wallet Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Network Configuration
NEXT_PUBLIC_APP_NETWORK=celo
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Squid Router
NEXT_PUBLIC_SQUID_INTEGRATOR_ID=your_integrator_id_here

# Celo attribution tags. Leave empty to derive from the app hostname.
NEXT_PUBLIC_CELO_ATTRIBUTION_CODE=
CELO_ATTRIBUTION_CODE=

# CoinGecko API Key
COIN_GECKO_API_KEY=your_api_key_here

# BRE-B / Bridge (Slice 1). Mock is on when BRIDGE_API_KEY is missing.
BRIDGE_MOCK=true
BRIDGE_API_KEY=
BRIDGE_API_BASE_URL=https://api.bridge.xyz
BRIDGE_WEBHOOK_SECRET=
BREB_MIN_COP=4000
BREB_MIN_USDC=2
BREB_FX_TTL_HOURS=6
COPBY_FEE_BPS=100
COPBY_FEE_WALLET=
BRIDGE_DEVELOPER_FEE_PERCENT=0.5
UNISWAP_V3_COPM_USDC_POOL=
UNISWAP_V3_SWAP_ROUTER=0x5615CDAb10dc425a742d643d949a7F474C01abc4
UNISWAP_V3_QUOTER=0x82825d0554fA07f7FC52Ab63c961F330fdEFa8E8
BREB_MOCK_OTP=123456
BREB_MOCK_AUTO_APPROVE_KYC=true
